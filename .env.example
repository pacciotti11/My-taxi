# --- Database ---
DATABASE_URL=postgresql://privateride:privateride_dev@localhost:5432/privateride

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=2592000      # seconds (30 days)

# --- Payments (sandbox until real credentials are configured) ---
PAYMENT_PROVIDER=sandbox     # sandbox | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Maps ---
MAPS_PROVIDER=stub           # stub | google | mapbox
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Notifications ---
EXPO_ACCESS_TOKEN=
SMTP_URL=

# --- Observability ---
SENTRY_DSN=
