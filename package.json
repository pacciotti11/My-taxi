{
  "name": "privateride",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @privateride/database migrate:dev",
    "db:generate": "pnpm --filter @privateride/database generate",
    "db:seed": "pnpm --filter @privateride/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "argon2",
      "unrs-resolver",
      "sharp",
      "@nestjs/core",
      "@swc/core",
      "bcrypt"
    ],
    "overrides": {
      "@react-navigation/native": "~7.0.14",
      "@react-navigation/core": "~7.3.0",
      "@react-navigation/bottom-tabs": "~7.2.0",
      "@react-navigation/native-stack": "~7.2.0",
      "@react-navigation/elements": "~2.2.5",
      "@react-navigation/routers": "~7.1.0"
    }
  }
}
