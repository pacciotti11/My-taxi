{
  "name": "privateride",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @privateride/database migrate:dev",
    "db:generate": "pnpm --filter @privateride/database generate",
    "db:seed": "pnpm --filter @privateride/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "argon2",
      "unrs-resolver",
      "sharp",
      "@nestjs/core",
      "@swc/core",
      "bcrypt"
    ]
  }
}
